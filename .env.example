# Copy to .env. Every key is optional: without keys the system runs fully offline with
# local retrieval, deterministic agents, browser speech, and Vosk ASR.
# Comments are on their own lines so the values can be pasted into hosting dashboards as-is.

# --- Backend ---
APP_ENV=local
# Public HTTPS URL of the backend; required when Vapi must reach the tool webhooks
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173
# Shared secret checked on Vapi webhooks (sent as X-Vapi-Secret); set a long random value
WEBHOOK_SECRET=
# Optional URL that receives escalation and callback events as JSON
ESCALATION_WEBHOOK_URL=

# --- Retrieval ---
# local | openai
EMBEDDING_PROVIDER=local
# Optional, e.g. http://localhost:6333 (in-memory index when empty)
QDRANT_URL=
RETRIEVAL_MIN_SCORE=0.40

# --- LLM (optional; grounded paraphrasing and semantic signal classification) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Voice platform (optional) ---
# Private key, used only by backend/scripts/sync_vapi.py
VAPI_API_KEY=
# Web SDK public key, exposed to the frontend via /api/config
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_BUSINESS_LOAN=
VAPI_ASSISTANT_PH=
VAPI_ASSISTANT_ID=

# --- Speech (optional) ---
# vosk | deepgram
ASR_PROVIDER=vosk
DEEPGRAM_API_KEY=
VOSK_MODEL_PATH=models/vosk-model-small-en-us-0.15
